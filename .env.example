# Copy this file to .env and fill in your own details.
# Never share your .env file or commit it to GitHub.

# ---------- Chat ----------
PORT=8090
# test = fixed answers without AI (free). claude = Claude API (later)
CHAT_MODE=test
# Claude API key (console.anthropic.com -> API Keys, starts with sk-ant-). Keep it secret.
ANTHROPIC_API_KEY=
# Claude model (leave as is unless you want to try another one)
CLAUDE_MODEL=claude-haiku-5-5
# Websites that may use the chat, comma separated (e.g. https://laboratoriumdiscounter.nl)
ALLOWED_ORIGINS=
# true only when the app can ONLY be reached through the Cloudflare Tunnel (docker-compose.yml sets this)
TRUST_CLOUDFLARE=false
# The test page /test.html (false when reachable from the internet; docker-compose.yml sets this)
SHOW_TEST_PAGE=true

# ---------- Shopify ----------
# Leave SHOPIFY_CLIENT_ID empty to use fake test orders instead of a real store.
# Store address, e.g. my-test-store.myshopify.com (without https://)
SHOPIFY_STORE_DOMAIN=
# Client ID of the app (Dev Dashboard -> your app -> Settings)
SHOPIFY_CLIENT_ID=
# Client secret of the app (starts with shpss_). Keep it secret.
SHOPIFY_CLIENT_SECRET=
# Public shop address, used for product links, e.g. https://laboratoriumdiscounter.nl
SHOP_URL=
# Own brand: shown first in stock answers with a "Huismerk" label (tag OR vendor)
HOUSE_BRAND_TAG=Huismerk
HOUSE_BRAND_VENDOR=Laboratoriumdiscounter

# ---------- Partial shipping (backorder) ----------
# off = not offered, log = only written to the log (testing), tag = saved as a tag on the order
SPLIT_SHIPMENT_MODE=log

# ---------- Contact form ----------
CONTACT_EMAIL_TO=info@laboratoriumdiscounter.nl
# false = messages are saved as files in CONTACT_SAVE_DIR instead of e-mailed
EMAIL_ENABLED=false
CONTACT_SAVE_DIR=./data/contact-requests
# Saved contact requests are deleted after this many days (AVG)
CONTACT_RETENTION_DAYS=90
SMTP_HOST=smtp.hostnet.nl
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
